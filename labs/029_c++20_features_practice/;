// 1. Sensor dashboard: filter and transform (warm-up)
// -------------------------------------------------
// Input: std::vector<int> temperatures_c{-40, 0, 10, 20, 100, 200};
// Values outside [-30, 120] are invalid sensor readings.
// Create a lazy pipeline that:
//   - keeps valid readings;
//   - converts Celsius to Fahrenheit using c * 9.0 / 5.0 + 32.0;
//   - exposes only the first three valid converted readings.
// Expected output: {32.0, 50.0, 68.0}.
// Requirements: use views::filter, views::transform, and views::take;
// do not create intermediate containers.
// Check: all-invalid input and empty input both produce no output.
// Explain: why is take(3) before filter a different operation?

std::vector<float> sensor([[maybe_unused]] std::vector<std::int64_t> temps) {
    auto view = temps | std::views::filter([](int64_t n) { return !(n < -30 || n > 120); }) |
                std::views::transform([](int64_t n) { return (n * 9.0 / 5.0 + 32.0); }) | std::views::take(3);

    std::vector<float> result;
    for (auto val : view) {
        result.push_back(static_cast<float>(val));
    }

    return result;
}

