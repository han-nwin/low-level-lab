// Check: finding 999 returns end(); never dereference that result.
// Explain: why can't you sort the filter view directly?

struct Order {
    int id;
    int total_cents;
    bool paid;
    bool operator==(const Order &) const = default;

    friend std::ostream &operator<<(std::ostream &os, const Order &order) {
        os << "Order{id=" << order.id << ", total_cents=" << order.total_cents
           << ", paid=" << (order.paid ? "true" : "false") << '}';
        return os;
    }
};

std::vector<Order> paid_orders([[maybe_unused]] std::span<const Order> orders) {
    // Filter use: std::invoke(&Order::paid, order);  // Same as order.paid
    auto view = orders | std::views::filter(&Order::paid);

    std::vector<Order> result;
    for (auto v : view) {
        result.push_back(v);
    }

    std::ranges::stable_sort(result, std::greater{}, &Order::total_cents);

    return result;
}

