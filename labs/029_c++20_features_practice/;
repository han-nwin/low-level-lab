// Test harness: you only need to edit the exercise functions above.
namespace tests {
int total = 0;
int passed = 0;

void require(bool condition, const char *message) {
    if (!condition) {
        throw std::runtime_error(message);
    }
}

template <std::ranges::input_range Actual, class T>
void expect_values(Actual &&actual, std::initializer_list<T> expected) {
    require(std::ranges::equal(actual, expected,
                               [](const auto &a, const auto &b) {
                                   return std::abs(static_cast<double>(a) - static_cast<double>(b)) < 1e-5;
                               }),
            "values or their order differ from the expected result");
}

template <class Test> void run(const std::string &name, Test test) {
    ++total;
    try {
        test();
        ++passed;
        std::cout << "PASS  " << name << '\n';
    } catch (const NotImplemented &e) {
        std::cout << "TODO  " << name << ": " << e.what() << '\n';
    } catch (const std::exception &e) {
        std::cout << "FAIL  " << name << ": " << e.what() << '\n';
    } catch (...) {
        std::cout << "FAIL  " << name << ": unknown exception\n";
    }
}
} // namespace tests

int main() {
    using tests::expect_values;
    using tests::require;
    using tests::run;

    run("1. sensor example", [] { expect_values(sensor({-40, 0, 10, 20, 100, 200}), {32.0, 50.0, 68.0}); });
    run("1. inclusive boundaries", [] { expect_values(sensor({-31, -30, 120, 121}), {-22.0, 248.0}); });
    run("1. all invalid", [] { expect_values(sensor({-40, 200}), std::initializer_list<float>{}); });
    run("1. empty", [] { expect_values(sensor({}), std::initializer_list<float>{}); });

    const std::vector<Order> orders{{101, 2500, true}, {102, 990, false}, {103, 4200, true}, {104, 2500, true}};
    run("2. paid orders, stable ties, unchanged input", [&] {
        auto input = orders;
        auto result = paid_orders(input);
        require(result == std::vector<Order>{orders[2], orders[0], orders[3]},
                "expected orders 103, 101, 104 with all fields preserved");
        require(input == orders, "input was modified");
    });
    run("2. no paid orders", [] {
        const std::array<Order, 1> input{{{1, 100, false}}};
        require(paid_orders(input).empty(), "expected no orders");
    });
    run("2. empty orders", [] { require(paid_orders({}).empty(), "expected no orders"); });
    run("2. find existing ID",
        [&] { require(find_order(orders, 104) == std::optional<Order>{orders[3]}, "expected order 104"); });
    run("2. find missing ID", [&] { require(!find_order(orders, 999), "expected nullopt"); });
    run("2. find in empty input", [] { require(!find_order({}, 104), "expected nullopt"); });

    run("3. live view and independent snapshot", [] {
        std::vector<int> prices{10, 20, 30};
        auto live = discounted_prices(prices);
        require(std::ranges::view<decltype(live)>, "return a view");
        std::vector<int> snapshot;
        for (int price : live)
            snapshot.push_back(price);
        expect_values(snapshot, {5, 15, 25});
        expect_values(prices, {10, 20, 30});
        prices[1] = 50;
        expect_values(live, {5, 45, 25});
        expect_values(snapshot, {5, 15, 25});
    });
    run("3. empty view", [] {
        std::vector<int> prices;
        expect_values(discounted_prices(prices), std::initializer_list<int>{});
    });

    run("4. vector buffer", [] {
        std::vector<float> samples{-0.75f, -0.25f, 0.25f, 0.75f};
        apply_gain(samples, 2.0f);
        expect_values(samples, {-1.0f, -0.5f, 0.5f, 1.0f});
    });
    run("4. std::array buffer", [] {
        std::array<float, 4> samples{-0.75f, -0.25f, 0.25f, 0.75f};
        apply_gain(samples, 2.0f);
        expect_values(samples, {-1.0f, -0.5f, 0.5f, 1.0f});
    });
    run("4. plain array buffer", [] {
        float samples[]{-0.75f, -0.25f, 0.25f, 0.75f};
        apply_gain(samples, 2.0f);
        expect_values(samples, {-1.0f, -0.5f, 0.5f, 1.0f});
    });
    run("4. zero gain", [] {
        float samples[]{-0.75f, 0.75f};
        apply_gain(samples, 0.0f);
        expect_values(samples, {0.0f, 0.0f});
    });
    run("4. empty buffer", [] { apply_gain({}, 2.0f); });

    run("5. valid packet borrows payload", [] {
        const std::vector<std::uint8_t> packet{0xA5, 3, 10, 20, 30};
        auto payload = parse_packet(packet);
        require(payload.has_value(), "expected a payload");
        require(payload->data() == packet.data() + 2, "payload must borrow packet storage");
        expect_values(*payload, {10, 20, 30});
    });
    run("5. successful empty payload", [] {
        const std::array<std::uint8_t, 2> packet{0xA5, 0};
        auto payload = parse_packet(packet);
        require(payload.has_value() && payload->empty(), "expected an engaged empty span");
    });
    const std::vector<std::vector<std::uint8_t>> malformed{{}, {0xA5}, {0x00, 0}, {0xA5, 3, 10}, {0xA5, 0, 99}};
    for (std::size_t i = 0; i < malformed.size(); ++i) {
        run("5. malformed packet " + std::to_string(i + 1),
            [&] { require(!parse_packet(malformed[i]), "expected nullopt"); });
    }

    const std::vector<Sample> samples{{1, 80, true},  {2, 150, false}, {3, 220, true},
                                      {4, 120, true}, {5, 300, true},  {6, 90, true}};
    run("6. report example and unchanged input", [&] {
        auto input = samples;
        expect_values(recent_slow_latencies(input, 3, 100, 2), {300.0, 120.0});
        require(input == samples, "input was modified");
    });
    run("6. zero limit",
        [&] { expect_values(recent_slow_latencies(samples, 3, 100, 0), std::initializer_list<double>{}); });
    run("6. no matching latency",
        [&] { expect_values(recent_slow_latencies(samples, 0, 1000, 2), std::initializer_list<double>{}); });
    run("6. no matching minute",
        [&] { expect_values(recent_slow_latencies(samples, 7, 0, 2), std::initializer_list<double>{}); });
    run("6. empty input", [] { expect_values(recent_slow_latencies({}, 0, 0, 2), std::initializer_list<double>{}); });
    run("6. large limit and failed samples excluded",
        [&] { expect_values(recent_slow_latencies(samples, 0, 100, 100), {300.0, 120.0, 220.0}); });
    run("6. inclusive boundaries", [&] { expect_values(recent_slow_latencies(samples, 4, 120, 100), {300.0, 120.0}); });
    run("6. result owns its storage", [&] {
        auto result = [&] {
            auto temporary = samples;
            return recent_slow_latencies(temporary, 3, 100, 2);
        }();
        expect_values(result, {300.0, 120.0});
    });

    std::cout << "\n" << tests::passed << '/' << tests::total << " tests passed\n";
    return tests::passed == tests::total ? 0 : 1;
}
